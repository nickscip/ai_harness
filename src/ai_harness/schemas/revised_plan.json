{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "preparation_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 1800},
          "purpose": {"type": "string", "minLength": 1}
        },
        "required": ["argv", "cwd", "timeout_seconds", "purpose"]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^P[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "files": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "verification": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "required": ["id", "title", "description", "files", "verification"]
      }
    },
    "verification_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
          "purpose": {"type": "string", "minLength": 1}
        },
        "required": ["argv", "cwd", "timeout_seconds", "purpose"]
      }
    },
    "risks": {"type": "array", "items": {"type": "string"}},
    "review_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "finding_id": {"type": "string", "pattern": "^R[0-9]{3}$"},
          "disposition": {"type": "string", "enum": ["fixed", "rejected", "deferred"]},
          "explanation": {"type": "string", "minLength": 1},
          "affected_steps": {"type": "array", "items": {"type": "string", "pattern": "^P[0-9]{3}$"}}
        },
        "required": ["finding_id", "disposition", "explanation", "affected_steps"]
      }
    }
  },
  "required": [
    "summary",
    "assumptions",
    "preparation_commands",
    "steps",
    "verification_commands",
    "risks",
    "review_resolutions"
  ]
}

