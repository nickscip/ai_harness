{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reviewer": {
      "type": "string",
      "enum": [
        "correctness_reviewer",
        "refactorer",
        "security_reviewer",
        "performance_expert",
        "resumability_reviewer",
        "contract_reviewer"
      ]
    },
    "verdict": {"type": "string", "enum": ["pass", "comment", "block", "abstain"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "scope_reviewed": {
      "type": "array",
      "maxItems": 50,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "residual_risks": {
      "type": "array",
      "maxItems": 10,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "findings": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": {"type": "string", "enum": ["blocker", "high", "medium", "low"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "body": {"type": "string", "minLength": 1, "maxLength": 2000},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "line": {"type": "integer", "minimum": 1},
                "side": {"type": "string", "enum": ["LEFT", "RIGHT"]},
                "excerpt": {"type": "string", "minLength": 1},
                "rationale": {"type": "string", "minLength": 1}
              },
              "required": ["path", "line", "side", "excerpt", "rationale"]
            }
          },
          "recommendation": {"type": "string", "minLength": 1, "maxLength": 1000},
          "suggested_verification": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "required": [
          "severity",
          "confidence",
          "title",
          "body",
          "evidence",
          "recommendation",
          "suggested_verification"
        ]
      }
    }
  },
  "required": ["reviewer", "verdict", "summary", "scope_reviewed", "residual_risks", "findings"]
}
