{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": {"type": "string", "enum": ["approve", "revise", "block"]},
    "summary": {"type": "string", "minLength": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^R[0-9]{3}$"},
          "severity": {"type": "string", "enum": ["blocker", "high", "medium", "low"]},
          "title": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {"type": "string", "enum": ["repository", "plan", "runtime"]},
                "path": {"type": "string", "minLength": 1},
                "line_start": {"type": "integer", "minimum": 1},
                "line_end": {"type": "integer", "minimum": 1},
                "excerpt": {"type": "string", "minLength": 1},
                "rationale": {"type": "string", "minLength": 1}
              },
              "required": ["source", "path", "line_start", "line_end", "excerpt", "rationale"]
            }
          },
          "recommendation": {"type": "string", "minLength": 1}
        },
        "required": ["id", "severity", "title", "claim", "evidence", "recommendation"]
      }
    },
    "required_changes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^R[0-9]{3}$"}
    }
  },
  "required": ["verdict", "summary", "findings", "required_changes"]
}

