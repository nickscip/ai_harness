{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "accepted_groups": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {"type": "string", "pattern": "^[a-z_]+:[1-5]$"}
          },
          "rationale": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "required": ["source_ids", "rationale"]
      }
    },
    "dismissed_groups": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {"type": "string", "pattern": "^[a-z_]+:[1-5]$"}
          },
          "reason": {
            "type": "string",
            "enum": ["trivial", "speculative", "yagni", "unsupported", "out_of_scope"]
          },
          "rationale": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "required": ["source_ids", "reason", "rationale"]
      }
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000}
  },
  "required": ["accepted_groups", "dismissed_groups", "summary"]
}
